# Database (Drizzle / Better Auth)
# Must match the credentials in compose.yaml
DATABASE_URL="postgres://cipher:mysecretpassword@localhost:5432/pyrags"

# Postgres password used by compose.yaml
APP_DB_PASSWORD="mysecretpassword"

# Public base URL of the frontend (used by Better Auth)
ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth
# https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# FastAPI backend base URL
PUBLIC_BASE_URL="http://localhost:8000"
