# OpenAI — embeddings and default chat provider
OPENAI_API_KEY=""

# Gemini — optional chat provider
GEMINI_API_KEY=""

# Optional frontend-only mock API; leave disabled outside local development
ENABLE_MOCK_API=false
MOCK_UPLOAD_DELAY_SECONDS=0.5
MOCK_STATUS_DELAY_SECONDS=1.5
MOCK_CHAT_DELAY_SECONDS=0.75

# Frontend origin — JWT issuer/audience
# JWKS is fetched from {FRONTEND_URL}/api/auth/jwks
FRONTEND_URL="http://localhost:5173"

# FastAPI debug mode — keep false outside local development
DEBUG=false

# PostgreSQL with pgvector; only the selected environment's URL is required
APP_ENV="development"
LOCAL_DATABASE_URL="postgresql+asyncpg://cipher:change-me@localhost:5433/pyrags"
NEON_DATABASE_URL=""

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Postgres password used by docker-compose.yaml (api-db service)
API_DB_PASSWORD="change-me"

DEBUG=false
MAX_UPLOAD_SIZE_MB=10
